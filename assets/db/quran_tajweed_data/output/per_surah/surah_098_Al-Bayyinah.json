      "rules_count": 1
    },
    {
      "verse_key": "98:3",
      "text_plain": "أَفَلَا یَنظُرُونَ إِلَى ٱلۡإِبِلِ كَیۡفَ خُلِقَتۡ",
      "text_tajweed_html": "أَفَلَا یَ<tajweed class=ikhpiaa>نظُ</tajweed>رُونَ إِلَى <tajweed class=ham_wasl>ٱ</tajweed>لۡإِبِلِ كَیۡفَ خُلِقَتۡ",
      "rules_count": 2
    },
    {
      "verse_key": "98:4",
      "text_plain": "وَإِلَى ٱلسَّمَاۤءِ كَیۡفَ رُفِعَتۡ",
      "text_tajweed_html": "وَإِلَى <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>سَّمَ<tajweed class=madda_obligatory>اۤ</tajweed>ءِ كَیۡفَ رُفِعَتۡ",
      "rules_count": 3
    },
    {
      "verse_key": "98:5",
      "text_plain": "وَإِلَى ٱلۡجِبَالِ كَیۡفَ نُصِبَتۡ",
      "text_tajweed_html": "وَإِلَى <tajweed class=ham_wasl>ٱ</tajweed>لۡجِبَالِ كَیۡفَ نُصِبَتۡ",
      "rules_count": 1
    },
    {
      "verse_key": "98:6",
      "text_plain": "وَإِلَى ٱلۡأَرۡضِ كَیۡفَ سُطِحَتۡ",
      "text_tajweed_html": "وَإِلَى <tajweed class=ham_wasl>ٱ</tajweed>لۡأَرۡضِ كَیۡفَ سُطِحَتۡ",
      "rules_count": 1
    },
    {
      "verse_key": "98:7",
      "text_plain": "فَذَكِّرۡ إِنَّمَاۤ أَنتَ مُذَكِّرࣱ",
      "text_tajweed_html": "فَذَكِّرۡ إِ<tajweed class=ghunnah>نَّ</tajweed>مَ<tajweed class=madda_permissible>اۤ</tajweed> أَ<tajweed class=ikhpiaa>نتَ</tajweed> مُذَكِّرࣱ",

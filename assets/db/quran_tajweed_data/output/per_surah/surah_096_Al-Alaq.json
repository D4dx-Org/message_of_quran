      "rules_count": 2
    },
    {
      "verse_key": "96:5",
      "text_plain": "وُجُوهࣱ یَوۡمَىِٕذࣲ نَّاعِمَةࣱ",
      "text_tajweed_html": "وُجُوه<tajweed class=idghaam_ghunnah>ࣱ یَ</tajweed>وۡمَىِٕ<tajweed class=idghaam_ghunnah>ذࣲ نّ</tajweed>َاعِمَةࣱ",
      "rules_count": 2
    },
    {

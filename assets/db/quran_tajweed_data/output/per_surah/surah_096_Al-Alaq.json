      "rules_count": 0
    },
    {
      "verse_key": "96:3",
      "text_plain": "لَّیۡسَ لَهُمۡ طَعَامٌ إِلَّا مِن ضَرِیعࣲ",
      "text_tajweed_html": "لَّیۡسَ لَهُمۡ طَعَامٌ إِلَّا مِ<tajweed class=ikhpiaa>ن ضَ</tajweed>رِ<tajweed class=madda_permissible>ی</tajweed>عࣲ",
      "rules_count": 2
    },
    {
